---
import { Image } from 'astro:assets';

interface Props {
  image: string;
  meta: string;
  title: string;
  href: string;
}

const { image, meta, title, href } = Astro.props;
---

<article class="insight-card">
  <div class="insight-card__image">
    <Image
      src={image}
      alt={title}
      width={800}
      height={450}
      loading="lazy"
      decoding="async"
    />
  </div>
  <span class="insight-card__meta">{meta}</span>
  <h3 class="insight-card__title">{title}</h3>
  <a href={href} class="insight-card__link">Read Analysis</a>
</article>

<style>
  .insight-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .insight-card__image {
    width: 100%;
    aspect-ratio: 16/9;
    background: #333;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .insight-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }

  .insight-card:hover .insight-card__image img {
    transform: scale(1.03);
  }

  .insight-card__meta {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .insight-card__title {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .insight-card__link {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: opacity 0.2s;
  }

  .insight-card__link:hover {
    opacity: 0.8;
  }
</style>
