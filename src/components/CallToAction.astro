---
interface Props {
  headline: string;
  ctaText: string;
  ctaHref: string;
}

const { headline, ctaText, ctaHref } = Astro.props;
---

<section class="cta">
  <div class="container">
    <h2 class="cta__headline" set:html={headline} />
    <a href={ctaHref} class="pill-btn pill-btn--inverse">
      {ctaText}
    </a>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(to top, #0A0F1C, var(--color-bg));
    text-align: center;
    padding: 10rem 0;
  }

  .cta__headline {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 3rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
